{
  "name": "readit",
  "version": "1.0.0",
  "description": "Local MCP browser for AI agents to read pages using your own Chromium profile",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "dashboard": "node dist/index.js dashboard"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.1.0",
    "pino": "^10.3.1",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "readit": "dist/index.js"
  }
}
